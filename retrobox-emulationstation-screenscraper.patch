+            --notes "batocera-emulationstation master @ \`${SHA}\` (commit of ${STAMP} UTC) with the patches in \`patches/\` applied. Built for ${DISTROS}, each for amd64 (x86_64) and arm64 (aarch64). Built ${ss}. Pick the file for your distribution and CPU: the architecture is at the end of the file name." \
             "${files[@]}"
 
   # When the scheduled run fails (typically a patch that no longer applies to
diff --git a/README.md b/README.md
index afe554027937bb528c4a965e106ba12dc626a4b8..490a4e5677495b2c25f7241043dc287d9a29912d 100644
--- a/README.md
+++ b/README.md
@@ -141,8 +141,36 @@ PKG_REVISION=1 scripts/build-deb.sh work/src dist   # or build-rpm.sh (same MICR
 * Known gap: upstream gives no origin or licence for its icons, flags, images
   and sounds in `resources/`; they are distributed under upstream's licence.
 
-## Not included on purpose
+## ScreenScraper
 
-`SCREENSCRAPER_DEV_LOGIN` is **not** baked into the binaries. It would end up
-in plain text inside a public release. ScreenScraper works with the user's own
-account configured in the menu.
+EmulationStation includes the ScreenScraper scraper **only if ScreenScraper's
+developer login is compiled in**. Without it the scraper is not in the menu at
+all (the same holds for TheGamesDB, HfsDB and RetroAchievements with their own
+keys). The login identifies the *software*; each user still enters their own
+ScreenScraper account in the menu.
+
+To build with it, give the build a developer login registered for the software:
+
+```bash
+SCREENSCRAPER_DEV_LOGIN='devid=<id>&devpassword=<password>' \
+SCREENSCRAPER_SOFTNAME='Retrobox-Emulationstation' \
+    scripts/build.sh work/src
+```
+
+In GitHub Actions, create the **repository secret `SCREENSCRAPER_DEV_LOGIN`**
+(Settings → Secrets and variables → Actions) with the same
+`devid=...&devpassword=...` value. The workflow then builds with it, the test
+job requires the scraper to be in the binary, `BUILDINFO` says
+`screenscraper: yes`, and the release notes say so. `SCREENSCRAPER_SOFTNAME`
+defaults to `Retrobox-Emulationstation`; use the name the login was registered
+for.
+
+**The login ends up in plain text inside the binary** (`strings` finds it), so
+anyone who downloads a public release can read it, and ScreenScraper can
+revoke it. Decide whether you accept that: if not, keep the secret out of the
+repository and build privately. GitHub masks the secret in the logs (the
+workflow also masks its two values separately), but only inside the workflow.
+Pull requests from forks cannot read the secret and build without it.
+
+Without the secret the packages build and pass the tests, just without
+ScreenScraper.
diff --git a/scripts/build.sh b/scripts/build.sh
index 39cca6c444a56994996f5dd356f3f0d4137dd0b4..009c81b058b3b7b87982c2fa4f2248b490f23b16 100755
--- a/scripts/build.sh
+++ b/scripts/build.sh
@@ -8,6 +8,16 @@
 #
 # Environment: MICROARCH  baseline (default) or v3, see common.sh. Each level
 #                         uses its own build directory, SRC/build-<MICROARCH>.
+#
+#   SCREENSCRAPER_DEV_LOGIN     "devid=<id>&devpassword=<password>", the developer
+#                               login of ScreenScraper. EmulationStation only
+#                               includes the ScreenScraper scraper when it is
+#                               compiled in; without it the scraper is not in
+#                               the menu at all.
+#   SCREENSCRAPER_SOFTNAME      software name sent to ScreenScraper (default:
+#                               Retrobox-Emulationstation); use the one the
+#                               login was registered for.
+# The login ends up in plain text inside the binary: see README.md.
 set -euo pipefail
 
 HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
@@ -22,13 +32,31 @@ BUILD="${SRC}/build-${MICROARCH}"
 export CFLAGS="${CFLAGS:+${CFLAGS} }${MARCH_FLAGS}"
 export CXXFLAGS="${CXXFLAGS:+${CXXFLAGS} }${MARCH_FLAGS}"
 
+# --- ScreenScraper -------------------------------------------------------------
+ss_args=()
+if [[ -n "${SCREENSCRAPER_DEV_LOGIN:-}" ]]; then
+    # Validate the shape without ever printing the value.
+    if [[ ! "${SCREENSCRAPER_DEV_LOGIN}" =~ ^devid=[^\&]+\&devpassword=[^\&]+$ ]]; then
+        echo "build.sh: SCREENSCRAPER_DEV_LOGIN must look like devid=<id>&devpassword=<password>" >&2
+        exit 1
+    fi
+    ss_args=(
+        "-DSCREENSCRAPER_DEV_LOGIN=${SCREENSCRAPER_DEV_LOGIN}"
+        "-DSCREENSCRAPER_SOFTNAME=${SCREENSCRAPER_SOFTNAME:-Retrobox-Emulationstation}"
+    )
+    echo "build.sh: ScreenScraper support: ON (softname ${SCREENSCRAPER_SOFTNAME:-Retrobox-Emulationstation})"
+else
+    echo "build.sh: ScreenScraper support: OFF (SCREENSCRAPER_DEV_LOGIN is not set, so the scraper will not exist)" >&2
+fi
+
 cmake -S "${SRC}" -B "${BUILD}" -G Ninja \
     -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
     -DCMAKE_BUILD_TYPE=Release \
     -DBATOCERA=OFF -DCEC=OFF \
     -DGL=ON -DGLES=OFF -DGLES2=OFF -DGLES3=OFF \
     -DUSE_SYSTEM_PUGIXML=ON \
-    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+    "${ss_args[@]}"
 verify_march "${BUILD}/compile_commands.json"
 cmake --build "${BUILD}" -j"$(nproc)"
 
diff --git a/scripts/stage.sh b/scripts/stage.sh
index cbb3b6992165527bf96af0bb552827e892624f8b..a72d5f50f0a658a89e92d9197f32185131067ea9 100755
--- a/scripts/stage.sh
+++ b/scripts/stage.sh
@@ -76,11 +76,15 @@ chmod 644 "${LIC}/nanosvg.NOTICE"
 
 # --- patches and build information --------------------------------------------
 install -m 644 "${REPO_ROOT}"/patches/*.patch "${DOC}/patches/"
+# The scraper only exists in the binary when the ScreenScraper login was compiled in.
+screenscraper="no"
+if grep -aq 'jeuInfos.php' "${ROOT}/emulationstation"; then screenscraper="yes"; fi
 cat > "${DOC}/BUILDINFO" <<EOF2
 upstream: ${UPSTREAM_URL}
 commit:   ${ES_SHA_FULL}
 date:     ${ES_STAMP} (UTC, commit date)
 patches:  $(find "${REPO_ROOT}/patches" -name '*.patch' | wc -l)
+screenscraper: ${screenscraper}
 EOF2
 chmod 644 "${DOC}/BUILDINFO"
 
diff --git a/tests/smoke.sh b/tests/smoke.sh
index bcd0a665ca9d881c3321fd1a55ca228a440a6f60..465a2d1a93f75523cb5630e78a2496d6146cf172 100755
--- a/tests/smoke.sh
+++ b/tests/smoke.sh
@@ -115,4 +115,13 @@ fi
 # a bare argv[0] upstream would look for resources in the wrong place).
 ( cd / && retrobox-emulationstation --help ) >/dev/null || fail "--help failed"
 
+# ScreenScraper: its scraper is only in the binary when the developer login was
+# compiled in. EXPECT_SCREENSCRAPER=1 (set by the workflow when the login secret
+# exists) makes its absence a failure.
+if grep -aq 'jeuInfos.php' "${BIN}"; then ss=yes; else ss=no; fi
+echo "smoke.sh: ScreenScraper support in the binary: ${ss}"
+if [[ "${EXPECT_SCREENSCRAPER:-0}" == 1 && "${ss}" != yes ]]; then
+    fail "the ScreenScraper login was configured but the binary has no ScreenScraper support"
+fi
+
 echo "smoke.sh: OK (${PKG##*/})"
