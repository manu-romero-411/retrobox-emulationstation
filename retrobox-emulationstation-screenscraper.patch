           inputs_hash="$({ cat patches/*.patch scripts/*.sh scripts/*.py licenses/*.txt packaging/copyright \
-            packaging/*.txt packaging/deb/* packaging/rpm/*; printf '%s' "${MATRIX}"; } | sha256sum | cut -c1-8)"
